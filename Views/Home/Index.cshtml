@model Dictionary<int, List<EvensonFamilyTreeAppsDev.Models.Person>>

@{
    ViewData["Title"] = "Home";
    var partnerships = ViewBag.Partnerships as List<EvensonFamilyTreeAppsDev.Models.Partnership>;
}

@if (!User.Identity?.IsAuthenticated ?? true)
{
    <div class="text-center mt-5">
        <h1>Welcome to The Family Tree</h1>
        <p class="lead">Log in or register to build and view your family tree.</p>

        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">Login</a>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-secondary">Register</a>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>My Family Tree</h1>

        <a asp-controller="Person" asp-action="Create" class="btn btn-primary">
            Add Ancestor
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <p>No ancestors found yet.</p>

        <a asp-controller="Person" asp-action="Create" class="btn btn-primary">
            Add Your First Ancestor
        </a>
    }
    else
    {
        @foreach (var generation in Model)
        {

            <div class="generation-row mb-5">
                @{
                    var renderedPersonIds = new HashSet<int>();
                    var generationPeople = generation.Value;
                }

                @foreach (var person in generationPeople)
                {
                    if (renderedPersonIds.Contains(person.Id))
                    {
                        continue;
                    }

                    var personPartnerships = partnerships?
                        .Where(p => p.Person1Id == person.Id || p.Person2Id == person.Id)
                        .OrderBy(p => p.EndDate.HasValue)
                        .ThenByDescending(p => p.StartDate)
                        .ToList() ?? new List<EvensonFamilyTreeAppsDev.Models.Partnership>();

                    var currentPartnership = personPartnerships
                        .FirstOrDefault(p =>
                            p.EndDate == null &&
                            generationPeople.Any(gp =>
                                gp.Id == p.Person1Id || gp.Id == p.Person2Id));

                    if (currentPartnership != null)
                    {
                        var partner = currentPartnership.Person1Id == person.Id
                            ? currentPartnership.Person2
                            : currentPartnership.Person1;

                        renderedPersonIds.Add(person.Id);
                        renderedPersonIds.Add(partner.Id);

                        <div class="couple-card">
                            @await Html.PartialAsync("_PersonTreeCard", person)

                            <div class="partnership-link current">
                                <span>@currentPartnership.RelationshipType?.Name</span>
                                <div class="heart">♥</div>
                            </div>

                            @await Html.PartialAsync("_PersonTreeCard", partner)
                        </div>
                    }
                    else
                    {
                        renderedPersonIds.Add(person.Id);

                        <div class="single-person-wrapper">
                            @await Html.PartialAsync("_PersonTreeCard", person)

                            @{
                                var pastRelationships = personPartnerships
                                    .Where(p => p.EndDate != null)
                                    .ToList();
                            }

                            @if (pastRelationships.Any())
                            {
                                <div class="past-relationships">
                                    <strong>Past relationships:</strong>
                                    @foreach (var relationship in pastRelationships)
                                    {
                                        var pastPartner = relationship.Person1Id == person.Id
                                            ? relationship.Person2
                                            : relationship.Person1;

                                        <div>
                                            @relationship.RelationshipType?.Name:
                                            @pastPartner.FirstName @pastPartner.LastName
                                            (@relationship.EndDate?.ToString("yyyy"))
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    }
}